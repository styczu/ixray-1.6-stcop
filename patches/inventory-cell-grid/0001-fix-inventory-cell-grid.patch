+        const Rasterized rb = rasterize(s.item_abs(b), b.wnd_size);
+        const Rasterized rc = rasterize(s.item_abs(c), c.wnd_size);
+        assert(rb.x1 - ra.x1 == 82.0f);
+        assert(rc.y1 - ra.y1 == 82.0f);
+        assert(ra.x2 - ra.x1 == 82.0f && ra.y2 - ra.y1 == 82.0f);
