+def body(text, signature):
+    start = text.index('{', text.index(signature))
+    depth, end = 1, start + 1
+    while depth:
+        if text[end] == '{':
+            depth += 1
+        elif text[end] == '}':
+            depth -= 1
+        end += 1
+    return text[start:end]
