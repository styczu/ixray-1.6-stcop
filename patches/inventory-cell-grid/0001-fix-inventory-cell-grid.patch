+        Scene s(5, 1, 41, 41, 24, 0);
+        Fvector2 last;
+        last.set(s.box.origin.x + s.box.wnd_size.x - 0.5f, s.box.origin.y + 0.5f);
+        Ivector2 want;
+        want.set(4, 0);
+        assert(s.box.PickCell(last) == want);
+    }
+
+    std::printf("ok\n");
+    return 0;
+}
