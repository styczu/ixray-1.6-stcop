local treasure_manager = nil
class "CTreasureManager"
function CTreasureManager:__init()
	self.items_spawned = false
	self.missing_checked = false -- [IX-Ray Refinements] treasure-missing-item-restore
	self.check_time = nil
	self.secrets = {}
		self.secret_restrs = {}
		self.items_from_secrets = {}
end

function CTreasureManager:initialize()
	local ini = ini_file("misc\\secrets.ltx")
	local n = ini:line_count("list")
	for i=0,n-1 do
		local result, id, value	= ini:r_line("list",i,"","")
		if(ini:section_exist(id)) then
			self.secrets[id] = {items = {}, given = false, empty = nil, refreshing = false, checked = false, to_find = 0, spot = nil}
					local items_count = ini:line_count(id)
					local item_section = ""
					for i=0,items_count-1 do
							result, item_section, str = ini:r_line(id,i,"","")
				if(item_section=="empty") then
									local parsed_condlist = xr_logic.parse_condlist(nil, "treasure_manager", "empty_cond", str)
					self.secrets[id].empty = parsed_condlist
				elseif(item_section=="refreshing") then
									local parsed_condlist = xr_logic.parse_condlist(nil, "treasure_manager", "refreshing_cond", str)
					self.secrets[id].refreshing = parsed_condlist
				-- [GUNSLINGER mod]
				elseif (item_section=="spot") then
					self.secrets[id].spot = ini:r_string(id, "spot")
				-- [/GUNSLINGER mod]
				else
									self.secrets[id].items[item_section] = {}
									local tbl = utils.parse_spawns(str)
									if(#tbl==0) then
											abort("There is no items count set for treasure [%s], item [%s]", id, item_section)
									end
					for i=1,#tbl do
						local tbl = {count = tonumber(tbl[i].section), prob = tonumber(tbl[i].prob or 1)}
						table.insert(self.secrets[id].items[item_section], tbl)
					end
				end
			end
		else
			abort("There is no section [%s] in secrets.ltx", tostring(id))
		end
	end
end

function CTreasureManager:fill(se_obj, treasure_id)
	return PROF_EVENT_CLOSURE("fill", function()
        if(self.secrets[treasure_id]) then
                    local item = self.secrets[treasure_id].items[se_obj:section_name()]
            if(item) then
                for i=1,#item do
                                if not(item[i].item_ids) then
                                        item[i].item_ids = {}
                                end
                                local count = #item[i].item_ids
                    if(count<item[i].count) then
                                        item[i].item_ids[count+1] = se_obj.id
                        return true
                    end
                end
            else
                abort("Attempt to register unknown item [%s] in secret [%s]", se_obj:section_name(), treasure_id)
            end
        else
            abort("Attempt to register item [%s] in unexistent secret [%s]", se_obj:name(), treasure_id)
        end
    end)
end

function CTreasureManager:register_item(se_obj)
	return PROF_EVENT_CLOSURE("register_item", function()
        local spawn_ini = se_obj:spawn_ini()
        if(spawn_ini:section_exist("secret")) then
            local result, id, value
            result, id, value	= spawn_ini:r_line("secret",0,"","")
            if id ~= "name" then
                abort("There is no 'name' field in [secret] section for object [%s]", se_obj:name())
            end
            if value == "" then
                abort("Field 'name' in [secret] section got no value for object [%s]", se_obj:name())
            end
            return self:fill(se_obj, value)
        end
    end)
end

function CTreasureManager:register_restrictor(se_obj)
	return PROF_EVENT_CLOSURE("register_restrictor", function()
        local spawn_ini = se_obj:spawn_ini()
        if(spawn_ini:section_exist("secret")) then
            self.secret_restrs[se_obj:name()] = se_obj.id
        end
    end)
end

function CTreasureManager:update()
	return PROF_EVENT_CLOSURE("update", function()
        if not(self.items_spawned) then
                for k,v in pairs(self.secrets) do
                        self:spawn_treasure(k)
                end
            self.items_spawned = true
        end
        -- [IX-Ray Refinements] treasure-missing-item-restore
        if not(self.missing_checked) then
            self.missing_checked = true
            self:restore_missing_items()
        end
        local global_time = time_global()
        if(self.check_time and global_time-self.check_time<=500) then
            return
        end
        self.check_time = global_time
    
            for k,v in pairs(self.secrets) do
                    if(v.given) then
                if(v.empty) then
                                local sect = xr_logic.pick_section_from_condlist(db.actor, nil, v.empty)
                                if(sect=="true") and not v.checked then
                                    -- [GUNSLINGER mod]
                                        local spot_type = v.spot
                                        if spot_type == nil then
                                            spot_type = "treasure"
                                        end	
                                        level.map_remove_object_spot(self.secret_restrs[k], spot_type)
                                    -- [/GUNSLINGER mod]
                                        xr_statistic.inc_founded_secrets_counter()
                                        v.empty = nil
                        v.checked = true
                                        printf("Empty secret [%s] remove map spot!", k)
                                end
                elseif(v.refreshing and v.checked) then
                                local sect = xr_logic.pick_section_from_condlist(db.actor, nil, v.refreshing)
                                if(sect=="true") then
                                        v.given = false
                                        v.checked = false
                                        printf("Given secret [%s] now is avaliable!", k)
                                end
                end
                    end
            end
    end)
end

function CTreasureManager:spawn_treasure(treasure_id)
	return PROF_EVENT_CLOSURE("spawn_treasure", function()
        if not(self.secrets[treasure_id]) then
            abort("There is no stored secret [%s]", tostring(treasure_id))
        end
        if(self.secrets[treasure_id].given) then
            printf("Secret [%s] already given!", treasure_id)
            return
        end
        for item_section,item_params in pairs(self.secrets[treasure_id].items) do
            for num = 1,#item_params do
                        for i = 1,item_params[num].count do
                                local prob = math.random()
                                if(prob<item_params[num].prob) then
                        if(item_params[num].item_ids and item_params[num].item_ids[i]) then
                                                local se_obj = alife():object(item_params[num].item_ids[i])
                                                local obj = alife():create( item_section,
                                                                                                        se_obj.position,
                                                                                                        se_obj.m_level_vertex_id,
                                                                                                        se_obj.m_game_vertex_id)
                                                obj.angle = se_obj.angle
                                                obj:use_ai_locations(se_obj:used_ai_locations())
                                                self.items_from_secrets[obj.id] = self.secret_restrs[treasure_id]
                                                self.secrets[treasure_id].to_find = self.secrets[treasure_id].to_find + 1
                        else
    --[[
                            log("----------->error id="..treasure_id)
                            print_table(self.secrets[treasure_id])
                            log("----------->item_section="..tostring(item_section))
                            log("----------->num="..tostring(num))
                            log("----------->i="..tostring(i))
                            log("----------->prob="..tostring(prob))
    ]]
                        end
                                end
                        end
            end
        end
    end)
end

-- [IX-Ray Refinements] treasure-missing-item-restore
-- Przedmiot skrytki, ktorego nie ma juz w alife (np. zabral go NPC, zanim
-- CItemManager::useful znow pomijal obiekty bez AI locations), wraca na swoj
-- znacznik. Bez tego to_find nie spada do zera i znacznik skrytki zostaje na
-- mapie na zawsze. Sekcja zgubionego przedmiotu nie jest zapisywana, wiec:
-- znaczniki skrytki minus jej obecne przedmioty, a przedmioty zabrane przez
-- gracza rozpoznaje ciagly blok ID z pierwszego spawnu. Gdy wynik nie jest
-- jednoznaczny, zgubiony przedmiot liczy sie tylko jako znaleziony.
local function treasure_log(fmt, ...)
	if log then
		log(string.format("* [treasure_manager] " .. fmt, ...))
	end
end

function CTreasureManager:restore_missing_items()
	local sim = alife()
	if not sim then
		return
	end
	local by_restr = {}
	for item_id, restr_id in pairs(self.items_from_secrets) do
		if not by_restr[restr_id] then
			by_restr[restr_id] = {}
		end
		table.insert(by_restr[restr_id], item_id)
	end
	for treasure_id, restr_id in pairs(self.secret_restrs) do
		local secret = self.secrets[treasure_id]
		if secret and by_restr[restr_id] then
			self:restore_treasure_items(sim, treasure_id, secret, restr_id, by_restr[restr_id])
		end
	end
end

function CTreasureManager:restore_treasure_items(sim, treasure_id, secret, restr_id, tracked)
	local remaining = {}
	local markers = {}
	for section, params in pairs(secret.items) do
		for num = 1, #params do
			local ids = params[num].item_ids
			if ids then
				for i = 1, #ids do
					remaining[section] = (remaining[section] or 0) + 1
					if not markers[section] then
						markers[section] = {}
					end
					table.insert(markers[section], ids[i])
				end
			end
		end
	end

	local tracked_set = {}
	local missing = {}
	for _, item_id in ipairs(tracked) do
		tracked_set[item_id] = true
		local se_obj = sim:object(item_id)
		local section = se_obj and se_obj:section_name()
		if section and remaining[section] and remaining[section] > 0 then
			remaining[section] = remaining[section] - 1
		else
			table.insert(missing, item_id)
		end
	end
	if #missing == 0 then
		return
	end

	local function remaining_total()
		local n = 0
		for _, count in pairs(remaining) do
			n = n + count
		end
		return n
	end
	-- przedmiot spoza skrytki o sekcji z jej listy: zabrany przez gracza
	local function account(id)
		if tracked_set[id] then
			return true
		end
		if self.items_from_secrets[id] then
			return false
		end
		local se_obj = sim:object(id)
		local section = se_obj and se_obj:section_name()
		if section and remaining[section] and remaining[section] > 0 then
			remaining[section] = remaining[section] - 1
			return true
		end
		return false
	end

	if remaining_total() > #missing then
		local lo, hi = 65535, 0
		for _, item_id in ipairs(tracked) do
			lo = math.min(lo, item_id)
			hi = math.max(hi, item_id)
		end
		local consistent = true
		for id = lo, hi do
			if not account(id) then
				consistent = false
				break
			end
		end
		if consistent then
			local id = lo - 1
			while remaining_total() > #missing and id >= 0 and account(id) do
				id = id - 1
			end
			id = hi + 1
			while remaining_total() > #missing and id < 65535 and account(id) do
				id = id + 1
			end
		end
	end

	if remaining_total() ~= #missing then
		for _, item_id in ipairs(missing) do
			self:on_item_take(item_id)
		end
		treasure_log("secret [%s]: %d missing item(s) of unknown section counted as found", treasure_id, #missing)
		return
	end

	local next_missing = 1
	for section, count in pairs(remaining) do
		for k = 1, count do
			local old_id = missing[next_missing]
			next_missing = next_missing + 1
			local marker = markers[section][k] and sim:object(markers[section][k])
			if marker then
				local obj = sim:create(section, marker.position, marker.m_level_vertex_id, marker.m_game_vertex_id)
				obj.angle = marker.angle
				obj:use_ai_locations(marker:used_ai_locations())
				self.items_from_secrets[old_id] = nil
				self.items_from_secrets[obj.id] = restr_id
				treasure_log("secret [%s]: missing item %d restored as [%s] %d", treasure_id, old_id, section, obj.id)
			else
				self:on_item_take(old_id)
				treasure_log("secret [%s]: missing item %d [%s] has no marker, counted as found", treasure_id, old_id, section)
			end
		end
	end
end

function CTreasureManager:give_treasure(treasure_id, spawn)
	return PROF_EVENT_CLOSURE("give_treasure", function()
        if not(self.secrets[treasure_id]) then
            abort("There is no stored secret [%s]", tostring(treasure_id))
        end
        if(self.secrets[treasure_id].given) then
            printf("Secret [%s] already given!", treasure_id)
            return
        end
        if(self.secrets[treasure_id].to_find==0 and not(self.secrets[treasure_id].empty)) then
            news_manager.send_treasure(2)
            printf("Secret [%s] already empty", treasure_id)
            return
        end
        if(spawn) then
            self:spawn_treasure(treasure_id)
        end
        
        -- [GUNSLINGER mod]
        local spot_type = self.secrets[treasure_id].spot
        if spot_type == nil then
            spot_type = "treasure"
        end	
        level.map_add_object_spot_ser(self.secret_restrs[treasure_id], spot_type, "")
        -- [/GUNSLINGER mod]
        
        self.secrets[treasure_id].given = true
        news_manager.send_treasure(0)
        printf("Give secret [%s]", treasure_id)
    end)
end

function CTreasureManager:give_random()
	return PROF_EVENT_CLOSURE("give_random", function()
        local rnd_tbl = {}
        for k,v in pairs(self.secrets) do
                    if not(v.given) then
                table.insert(rnd_tbl, k)
                    end
        end
        if(#rnd_tbl~=0) then
                self:give_treasure(rnd_tbl[math.random(1,#rnd_tbl)])
            return
        end
        printf("There are no treasures avaliable!")
    end)
end

function CTreasureManager:on_item_take(obj_id)
	return PROF_EVENT_CLOSURE("on_item_take", function()
        local restr_id = self.items_from_secrets[obj_id]
        local treasure_id = nil
        for k,v in pairs(self.secret_restrs) do
            if(restr_id==v) then
                treasure_id = k
            end
        end
        if(treasure_id) then
                    self.secrets[treasure_id].to_find = self.secrets[treasure_id].to_find - 1
            if(self.secrets[treasure_id].to_find==0) then
                -- [GUNSLINGER mod]
                local spot_type = self.secrets[treasure_id].spot
                if spot_type == nil then
                    spot_type = "treasure"
                end	
                level.map_remove_object_spot(self.secret_restrs[treasure_id], spot_type)
                -- [/GUNSLINGER mod]
                xr_statistic.inc_founded_secrets_counter()
                printf("Secret [%s] now is empty!", treasure_id)
                self.secrets[treasure_id].checked = true
                news_manager.send_treasure(1)
            end
            self.items_from_secrets[obj_id] = nil
        end
    end)
end

-- [GUNSLINGER mod]
function CTreasureManager:is_secret_item(obj_id)
	local restr_id = self.items_from_secrets[obj_id]
	return restr_id ~= nil
end
-- [/GUNSLINGER mod]
function CTreasureManager:save(package)
	return PROF_EVENT_CLOSURE("save", function()
        set_save_marker(package, "save", false, "CTreasureManager")
        package:w_bool(self.items_spawned)
        local num = 0
        for k,v in pairs(self.items_from_secrets) do
            num = num + 1
        end
        package:w_u16(num)
        for k,v in pairs(self.items_from_secrets) do
            package:w_object_id(k)
            package:w_object_id(v)
        end
    
        num = 0
        for k,v in pairs(self.secrets) do
            num = num + 1
        end
        package:w_u16(num)
        for k,v in pairs(self.secrets) do
            if not(self.secret_restrs[k]) then
                package:w_object_id(-1)
            else
                package:w_object_id(self.secret_restrs[k])
            end
            package:w_bool(v.given)
            package:w_bool(v.checked)
            package:w_u8(v.to_find)
        end
        set_save_marker(package, "save", true, "CTreasureManager")
    end)
end

function CTreasureManager:load(package)
 	return PROF_EVENT_CLOSURE("load", function()
        set_save_marker(package, "load", false, "CTreasureManager")
        self.items_spawned = package:r_bool()
        self.items_from_secrets = {}
        local num = package:r_u16()
        for i=1,num do
            local k = package:r_object_id()
            local v = package:r_object_id()
            self.items_from_secrets[k] = v
        end
    
        local num = package:r_u16()
        for i=1,num do
            local id = package:r_object_id()
            for k,v in pairs(self.secret_restrs) do
                if(v==id) then
                    id = k
                    break
                end
            end
            local given = package:r_bool()
            local checked = package:r_bool()
            local to_find = package:r_u8()
            if(id~=alife_const.invalid_object_id and self.secrets[id]) then
                self.secrets[id].given = given
                self.secrets[id].checked = checked
                self.secrets[id].to_find = to_find
            end
        end
        set_save_marker(package, "load", true, "CTreasureManager")
    end)
end
--------------------------------------------------------------------------------
function get_treasure_manager()
	if(treasure_manager==nil) then
		treasure_manager = CTreasureManager()
		treasure_manager:initialize()
	end
	return treasure_manager
end
