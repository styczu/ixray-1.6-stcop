----------------------------------------------------------------------------------------------------------------------
--'	Схема игнорирования денжеров.
--'	автор: Диденко Руслан (Stohe)
--'	TODO:
----------------------------------------------------------------------------------------------------------------------
local DANGER_IGNORE_DISTANCE = 150

local ignore_distance = {
	[danger_object.grenade] 		= 15,
	[danger_object.entity_corpse] 	= 10,
	[danger_object.entity_attacked] = 150,
	[danger_object.attacked] 		= 150,
	[danger_object.bullet_ricochet] = 2,
	[danger_object.enemy_sound] 	= 0,
	[danger_object.attack_sound] 	= 20,
	[danger_object.entity_death] 	= 4
}



local DANGER_INERTION_TIME	= 30000

-- npc-corpse-alarm (stealth model stage 5, ai_stealth 1 and ai_stealth_corpses 1):
-- a human killed by the actor alarms its allies. The danger is the vanilla
-- "fresh corpse" danger of the engine (take cover, look around, search):
-- * the first ally that sees the body within its stealth sight range (rank and
--   time of day, as for the actor), or hears the death (ai_stealth_death_hear m),
--   reacts and passes the danger to its online squad;
-- * then the body is known (saved in its pstor) and alarms nobody else.
-- An alarmed NPC reacts for CORPSE_REACT_TIME. A body that will never count
-- for the NPC is ignored by its danger memory, so it does not hide a newer
-- danger. With the model off the vanilla rule stays: every corpse is ignored.
local CORPSE_REACT_TIME = 60000
-- The danger time of a corpse is the last time the NPC saw it: discovery
-- needs a body seen now, not one remembered from before.
local CORPSE_SEEN_TIME = 1000
local KILLED_BY_ACTOR = "ixr_killed_by_actor"
local CORPSE_KNOWN = "ixr_corpse_known"

-- [corpse id] = {[npc id] = start of the reaction, 0 = alarmed, not reacting yet}
local corpse_alarms = {}

function corpse_alarm_enabled()
	local console = get_console()
	return console:get_integer("ai_stealth") ~= 0 and console:get_integer("ai_stealth_corpses") ~= 0
end

local function pstor_get(obj, name)
	local st = db.storage[obj:id()]
	return st ~= nil and st.pstor ~= nil and st.pstor[name] or nil
end

-- Humans that may react: no zombies, traders and story NPCs (own or squad story id).
function corpse_observer(npc)
	if not IsStalker(npc) or (db.actor and npc:id() == db.actor:id()) or not npc:alive() then
		return false
	end
	local community = character_community(npc)
	if community == "zombied" or community == "trader" or npc:clsid() == clsid.trader then
		return false
	end
	if get_object_story_id(npc:id()) then
		return false
	end
	local squad = get_object_squad(npc)
	return not (squad ~= nil and get_object_story_id(squad.id) ~= nil)
end

local function alarmed_corpse(npc, corpse)
	return IsStalker(corpse) and not corpse:alive() and pstor_get(corpse, KILLED_BY_ACTOR) == true
		and corpse_observer(npc) and npc:relation(corpse) ~= game_object.enemy
end

local function alarm(corpse, npc)
	local list = corpse_alarms[corpse:id()]
	if list == nil then
		list = {}
		corpse_alarms[corpse:id()] = list
	end
	if list[npc:id()] == nil then
		list[npc:id()] = 0
		npc:make_object_visible_somewhen(corpse)
	end
end

local function alarm_squad(corpse, npc)
	local squad = get_object_squad(npc)
	if squad == nil then
		return
	end
	for i = 0, squad:npc_count() - 1 do
		local st = db.storage[squad:getSquadMemberId(i)]
		local member = st and st.object
		if member and member:id() ~= npc:id() and alarmed_corpse(member, corpse) then
			alarm(corpse, member)
		end
	end
end

-- Does the corpse danger count for the NPC (no side effects). The second
-- result marks a corpse that will never count for this NPC.
function corpse_danger(npc, danger, corpse)
	if not corpse_alarm_enabled() then
		return false, false
	end
	if not alarmed_corpse(npc, corpse) then
		return false, true
	end
	local list = corpse_alarms[corpse:id()]
	local start = list and list[npc:id()]
	if start ~= nil then
		local reacts = start == 0 or time_global() - start < CORPSE_REACT_TIME
		return reacts, not reacts
	end
	if pstor_get(corpse, CORPSE_KNOWN) == true then
		return false, true
	end
	if not (danger:time() >= corpse:death_time() and time_global() - danger:time() < CORPSE_SEEN_TIME) then
		return false, false
	end
	-- the stealth sight range of the observer (rank, time of day): at night a body is noticed as late as the actor
	local range = npc:stealth_corpse_range()
	return npc:position():distance_to_sqr(corpse:position()) <= range * range, false
end

-- The NPC reacts: the body becomes known, the squad of the NPC gets the danger.
function corpse_react(npc, corpse)
	local list = corpse_alarms[corpse:id()]
	if list == nil then
		list = {}
		corpse_alarms[corpse:id()] = list
	end
	local start = list[npc:id()]
	if start ~= nil and start ~= 0 then
		return
	end
	list[npc:id()] = time_global()
	xr_logic.pstor_store(corpse, CORPSE_KNOWN, true)
	alarm_squad(corpse, npc)
end

-- xr_motivator death_callback: remember a kill by the actor; allies within
-- ai_stealth_death_hear m hear the death.
function on_npc_death(victim, who)
	if not (db.actor and who and who:id() == db.actor:id() and IsStalker(victim) and db.storage[victim:id()]) then
		return
	end
	corpse_alarms[victim:id()] = nil -- the id of a released body comes back
	xr_logic.pstor_store(victim, KILLED_BY_ACTOR, true)
	if not corpse_alarm_enabled() then
		return
	end
	local range = get_console():get_float("ai_stealth_death_hear")
	local range_sqr = range * range
	local position = victim:position()
	for id, st in pairs(db.storage) do
		local npc = st.object
		if npc and id ~= victim:id() and alarmed_corpse(npc, victim)
			and npc:position():distance_to_sqr(position) <= range_sqr
		then
			alarm(victim, npc)
		end
	end
end


function get_danger_name(best_danger)
	local best_danger_object = best_danger:object()
	local bd_type = best_danger:type()

	if bd_type ~= danger_object.grenade and best_danger:dependent_object() ~= nil then
		best_danger_object = best_danger:dependent_object()
	end

	if best_danger_object == nil then
		return "none"
	end
	return best_danger_object:name()
end

-- Функция, проверяющая, нужно ли реагировать на денжер. Возвращает FALSE, когда реагировать не надо
function is_danger(npc)
	local best_danger = npc:best_danger()

	-- проверка на наличие денжера.
	if best_danger == nil then
		return false
	end

	-- Получение объекта, спровоцировавшего денжер
	local best_danger_object = best_danger:object()
	local bd_type = best_danger:type()

	if bd_type ~= danger_object.grenade and best_danger:dependent_object() ~= nil then
		best_danger_object = best_danger:dependent_object()
	end

	-- Проверяем наличие объекта денжера.
	if best_danger_object == nil then
		return false
	end

	-- Игнорим денжеры не от врагов. (кроме трупов и гранат)
	if bd_type ~= danger_object.entity_corpse and bd_type ~= danger_object.grenade and
		 npc:relation(best_danger_object) ~= game_object.enemy
	then
		--printf("[%s] check danger RELATION", npc:name())
		return false
	end

	-- Зомби игнорируют гранаты
	if bd_type == danger_object.grenade then
		if character_community(npc) == "zombied" then
			return false
		end
	end

	-- Игнорируем старые трупы
	-- npc-corpse-alarm: except a body of an ally killed by the actor (above)
	local alarm_corpse = nil
	if bd_type == danger_object.entity_corpse then
		local counts, never = corpse_danger(npc, best_danger, best_danger_object)
		if not counts then
			if never then
				-- the engine picks one danger: a body that never counts must not hide a newer one
				npc:ignore_danger_object(best_danger_object)
			end
			return false
		end
		alarm_corpse = best_danger_object
		--local corpse_object = best_danger:object()
		--if time_global() - corpse_object:death_time() >= DANGER_INERTION_TIME then
		--	return false
		--end
	end

	--' отсеиваем по настройке combat_ignore/danger
	if not xr_combat_ignore.is_enemy(npc, best_danger_object, db.storage[npc:id()].combat_ignore, true) then
		--printf("[%s] check danger COMBAT IGNORE", npc:name())
		return false
	end


	-- Отсеиваем по дистанции
	local danger_distance_sqr = best_danger:position():distance_to_sqr(npc:position())
	local ignore_distance_by_type = ignore_distance[bd_type]
	--printf("[%s] check danger type %s, distance %s", npc:name(), bd_type, tostring(ignore_distance_by_type))
	--log(string.format( "[%s] check danger type %s, distance %s", npc:name(), bd_type, tostring(ignore_distance_by_type) ))
	if alarm_corpse ~= nil then
		-- seen or passed by the squad: no distance limit
	elseif ignore_distance_by_type ~= nil then
	 	if danger_distance_sqr >= ignore_distance_by_type*ignore_distance_by_type then
			return false
		end
	elseif danger_distance_sqr >= DANGER_IGNORE_DISTANCE*DANGER_IGNORE_DISTANCE then
		return false
	end


	--' Отсеиваем по зоне
	local active_sector = db.storage[npc:id()].active_sector
	if active_sector ~= nil then
		if sr_danger.check_danger_position(best_danger:position(), active_sector) == false then
			return false
		end
	end

	-- Отсеиваем тяжелораненых
	if xr_wounded.is_heavy_wounded_by_id(npc:id()) then
		return false
	end


	-- Кемперы игнорируют все, кроме гранат
	if active_scheme == "camper" and
		 bd_type ~= danger_object.grenade
	then
		return false
	end

	if alarm_corpse ~= nil then
		corpse_react(npc, alarm_corpse)
	end

	return true
end


function get_danger_time(danger)
	if danger:type() == danger_object.entity_corpse then
		local corpse_object = danger:object()
		return corpse_object:death_time()
	end
	
	return danger:time()
end

----------------------------------------------------------------------------------------------------------------------
-- EVALUATORS
----------------------------------------------------------------------------------------------------------------------
-- true - есть danger, false - нет danger
class "evaluator_danger" (property_evaluator)
function evaluator_danger:__init(name, storage, npc) super (nil, name)
	self.a = storage
end

function evaluator_danger:evaluate()
	--printf("evaluator danger %s",  self.object:name())
	if self.mgr == nil then
		self.mgr = self.object:motivation_action_manager()
	end

	local flags_into_callbacks = {ret_value = true}
	SendScriptCallback("npc_on_eval_danger", self.object, flags_into_callbacks)
	if flags_into_callbacks.ret_value == false then
		db.storage[self.object:id()].danger_flag = flags_into_callbacks.ret_value
		
		return false 
	end

	-- инерция возврата
	if self.a.danger_time ~= nil and self.object:best_danger() ~= nil and time_global() - self.a.danger_time < DANGER_INERTION_TIME then
	 	--printf("%s [%s] [%s]", self.object:name(), time_global() - self.danger_time, DANGER_INERTION_TIME)

		db.storage[self.object:id()].danger_flag = true
		
		--printf(" [%s] return true by time %s", tostring(time_global()), self.object:name())		
		return true
	end


	if is_danger(self.object) ~= true then
		db.storage[self.object:id()].danger_flag = false
		--printf(" [%s] return false %s", tostring(time_global()), self.object:name())
		return false
	end

	if self.mgr:initialized() and self.mgr:current_action_id() == stalker_ids.action_danger_planner then
		self.a.danger_time = get_danger_time(self.object:best_danger())
	end

	db.storage[self.object:id()].danger_flag = true

	-- Стремаем смарт террейн
	local se_obj = alife():object(self.object:id())
	if se_obj and se_obj.m_smart_terrain_id ~= alife_const.invalid_object_id then
		alife():object(se_obj.m_smart_terrain_id):set_alarm()
	end
	
	--printf(" [%s] return true %s", tostring(time_global()), self.object:name())
	return true
end


----------------------------------------------------------------------------------------------------------------------
-- BINDER
----------------------------------------------------------------------------------------------------------------------
function add_to_binder(object, ini, scheme, section, storage)
	--printf("init DANGER!!!")
	local operators	= {}
	local properties  = {}
	local manager = object:motivation_action_manager()


	local danger_action = manager:action(stalker_ids.action_danger_planner)		
	local danger_action_planner = cast_planner(danger_action)

	manager:remove_evaluator(stalker_ids.property_danger)
	manager:add_evaluator(stalker_ids.property_danger, this.evaluator_danger("danger", storage, object))

	danger_action_planner:remove_evaluator(stalker_ids.property_danger)
	danger_action_planner:add_evaluator(stalker_ids.property_danger, this.evaluator_danger("danger", storage, object))
end
function set_danger(npc, ini, scheme, section)
	local st = xr_logic.assign_storage_and_bind(npc, ini, scheme, section)
	db.storage[npc:id()].danger_flag = false
end

function reset_danger(npc, scheme, st, section)
	local danger_section
	if scheme ~= nil and scheme ~= "nil" then
		danger_section = utils.cfg_get_string(st.ini, section, "danger", npc, false, "")
	end

--	printf("DANGER SECTION [%s]", utils.to_str(danger_section))
end
